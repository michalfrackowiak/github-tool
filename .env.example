# Template only — export these in your shell; there is no automatic .env loader.
# The app never prints the token. Prefer a fine-grained PAT with public
# repository Contents + Metadata read-only: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional: where the local index lives (default: ~/.github-tool/github-tool.db)
GITHUB_TOOL_DB=

# Optional: force offline mode ("1") so no network calls are made.
GITHUB_TOOL_OFFLINE=

# Optional LLM pass for Phase 6 extraction (OpenAI-compatible endpoint).
GITHUB_TOOL_LLM_URL=
GITHUB_TOOL_LLM_KEY=
GITHUB_TOOL_LLM_MODEL=
